            print("(no labels in use)")
            return
        for r in rows:
            print(f"{r['label']:<24} {r['count']:>3} card(s)   {r['color'] or '(no color)'}")
        return

    if args.action == "color":
        # accepts both `swrm label color <naam> <kleur>` and `... --color <kleur>`
        name, color = args.id, args.label
        if args.color is not None:
            color = args.color
        if not name:
            die("usage: swrm label color <label> [<kleur>]  (kleur: "
                + ", ".join(LABEL_COLORS) + "; empty clears)", 2)
        color = color or ""
        if color and color not in LABEL_COLORS:
            die(f"color must be one of: {', '.join(LABEL_COLORS)} (or '' to clear)", 2)
        con.execute("BEGIN IMMEDIATE")
        try:
            con.execute(
                "INSERT INTO label_colors (name, color) VALUES (?,?)"
                " ON CONFLICT(name) DO UPDATE SET color=excluded.color",
                (name, color),
            )
            emit(con, actor, "label-color", None, label=name, color=color)
            con.execute("COMMIT")
        except Exception:
            con.execute("ROLLBACK")
            raise
        con.close()
        out(args, f"label '{name}' color -> {color or '(none)'}",
            {"label": name, "color": color})
        return

    # add / rm / rm-all operate on one card
    con.execute("BEGIN IMMEDIATE")
    try:
        t = get_task(con, args.id)
        cur = list(t["labels"])
        if args.action == "add":
            wanted = [lb for lb in ([args.label] + list(args.more_labels or [])) if lb]
            if not wanted:
                die("no labels given", 2)
            dupes = [lb for lb in wanted if lb in cur]
            if dupes:
                con.execute("ROLLBACK")
                con.close()
                die(f"already on {t['id']}: {', '.join(dupes)}", 1)
            labels = cur + wanted
            emit(con, actor, "labeled", t["id"], labels=list(wanted))
            msg = f"labeled {t['id']} with {', '.join(wanted)}"
        elif args.action == "rm":
            wanted = [lb for lb in ([args.label] + list(args.more_labels or [])) if lb]
            if not wanted:
                die("no labels given", 2)
            missing = [lb for lb in wanted if lb not in cur]
            if missing:
                con.execute("ROLLBACK")
                con.close()
                die(f"not on {t['id']}: {', '.join(missing)}", 1)
            labels = [lb for lb in cur if lb not in wanted]
            emit(con, actor, "unlabeled", t["id"], labels=list(wanted))
            msg = f"removed {', '.join(wanted)} from {t['id']}"
        elif args.action == "rm-all":
            labels = []
            if cur:
                emit(con, actor, "unlabeled", t["id"], labels=list(cur))
            msg = f"cleared {len(cur)} label(s) from {t['id']}"
        else:
            con.execute("ROLLBACK")
            con.close()
            die(f"unknown label action: {args.action}", 2)
        con.execute("UPDATE tasks SET labels=?, updated_at=? WHERE id=?",
                    (",".join(labels), now_iso(), t["id"]))
        con.execute("COMMIT")
    except Exception:
        try:
            con.execute("ROLLBACK")
        except sqlite3.Error:
            pass
        raise
    t = get_task(con, args.id)
    con.close()
    out(args, msg, t)


def cmd_link(args):
    con = connect(resolve_db(args))
    actor = resolve_actor(args)
    con.execute("BEGIN IMMEDIATE")
    try:
        get_task(con, args.parent)
        child = get_task(con, args.child)
        if args.parent == args.child:
            con.execute("ROLLBACK")
            con.close()
            die("cannot link a task to itself", 2)
        con.execute("INSERT OR IGNORE INTO links (parent_id, child_id) VALUES (?,?)", (args.parent, args.child))
        emit(con, actor, "linked", args.child, parent=args.parent)
        # A child with unfinished parents must not be runnable.
        if child["status"] in ("ready", "doing") and not all_parents_done(con, args.child):
            con.execute("UPDATE tasks SET status='todo', updated_at=? WHERE id=?", (now_iso(), args.child))
            emit(con, actor, "demoted", args.child, reason=f"parent {args.parent} not done")
        con.execute("COMMIT")
    except Exception:
        try:
            con.execute("ROLLBACK")
        except sqlite3.Error:
            pass
        raise
    con.close()
    out(args, f"linked {args.parent} -> {args.child}", {"parent": args.parent, "child": args.child})


def cmd_unlink(args):
    con = connect(resolve_db(args))
    actor = resolve_actor(args)
    con.execute("BEGIN IMMEDIATE")
    try:
        cur = con.execute("DELETE FROM links WHERE parent_id=? AND child_id=?", (args.parent, args.child))
        if cur.rowcount == 0:
            con.execute("ROLLBACK")
            con.close()
            die(f"no link {args.parent} -> {args.child}", 1)
        emit(con, actor, "unlinked", args.child, parent=args.parent)
        recheck_promotion(con, actor, args.child)
        con.execute("COMMIT")
    except Exception:
        try:
            con.execute("ROLLBACK")
        except sqlite3.Error:
