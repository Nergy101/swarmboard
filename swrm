#!/usr/bin/env python3
"""swrm — the swarmboard CLI: a CLI-first kanban board for multiple agents
working at once, with a live change feed.

Single-file, stdlib-only. State lives in one SQLite database (WAL mode), so
any number of agents/processes can read and write concurrently. Every mutation
is appended to an `events` table in the same transaction; `swrm watch`
streams that feed live.

Board location: --db PATH, else $KANBAN_DB, else ./.kanban/kanban.db
Actor identity: --actor NAME, else $KANBAN_ACTOR, else $USER, else "unknown"
Remote mode: --url URL or $KANBAN_URL (leader-follower via `swrm serve`)
"""

import argparse
import io
import json
import os
import shutil
import sqlite3
import sys
import time
import urllib.parse
import urllib.request
import uuid
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

STATUSES = ["todo", "ready", "doing", "done", "blocked", "archived"]
ACTIVE_STATUSES = ["todo", "ready", "doing", "blocked"]
DEFAULT_CLAIM_TTL = int(os.environ.get("KANBAN_CLAIM_TTL", "900"))  # seconds

SCHEMA = """
CREATE TABLE IF NOT EXISTS tasks (
    id               TEXT PRIMARY KEY,
    title            TEXT NOT NULL,
    body             TEXT NOT NULL DEFAULT '',
    status           TEXT NOT NULL DEFAULT 'todo',
    priority         INTEGER NOT NULL DEFAULT 0,
    assignee         TEXT NOT NULL DEFAULT '',
    labels           TEXT NOT NULL DEFAULT '',
    result           TEXT NOT NULL DEFAULT '',
    created_at       TEXT NOT NULL,
    updated_at       TEXT NOT NULL,
    claimed_by       TEXT NOT NULL DEFAULT '',
    claimed_at       TEXT NOT NULL DEFAULT '',
    claim_expires_at TEXT NOT NULL DEFAULT ''
);
CREATE TABLE IF NOT EXISTS links (
    parent_id TEXT NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
    child_id  TEXT NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
    PRIMARY KEY (parent_id, child_id)
);
CREATE TABLE IF NOT EXISTS events (
    id      INTEGER PRIMARY KEY AUTOINCREMENT,
    ts      TEXT NOT NULL,
    actor   TEXT NOT NULL,
    action  TEXT NOT NULL,
    task_id TEXT,
    details TEXT NOT NULL DEFAULT '{}'
);
CREATE INDEX IF NOT EXISTS idx_tasks_status   ON tasks(status);
CREATE INDEX IF NOT EXISTS idx_tasks_assignee ON tasks(assignee);
CREATE INDEX IF NOT EXISTS idx_links_child    ON links(child_id);
CREATE INDEX IF NOT EXISTS idx_events_id      ON events(id);
"""


# ---------------------------------------------------------------- helpers

def now_iso():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def resolve_db(args):
    path = args.db or os.environ.get("KANBAN_DB") or os.path.join(".kanban", "kanban.db")
    return os.path.abspath(path)


def resolve_actor(args):
    return args.actor or os.environ.get("KANBAN_ACTOR") or os.environ.get("USER") or "unknown"


def connect(path, create=True):
    if create:
        d = os.path.dirname(path)
        if d:
            os.makedirs(d, exist_ok=True)
    con = sqlite3.connect(path, timeout=15, isolation_level=None)
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("PRAGMA busy_timeout=15000")
    con.execute("PRAGMA foreign_keys=ON")
    con.execute("PRAGMA synchronous=NORMAL")
    if create:
        con.executescript(SCHEMA)
    return con


def emit(con, actor, action, task_id=None, **details):
    con.execute(
        "INSERT INTO events (ts, actor, action, task_id, details) VALUES (?,?,?,?,?)",
        (now_iso(), actor, action, task_id, json.dumps(details, ensure_ascii=False)),
    )


def new_id():
    return "t_" + uuid.uuid4().hex[:8]


def row_to_task(r):
    d = dict(r)
    d["labels"] = [x for x in d["labels"].split(",") if x]
    return d


def get_task(con, task_id):
    r = con.execute("SELECT * FROM tasks WHERE id=?", (task_id,)).fetchone()
    if not r:
        die(f"no such task: {task_id}", 1)
    return row_to_task(r)


def parent_statuses(con, child_id):
    rows = con.execute(
        "SELECT p.id, p.status FROM links l JOIN tasks p ON p.id = l.parent_id WHERE l.child_id=?",
        (child_id,),
    ).fetchall()
    return [(r["id"], r["status"]) for r in rows]


def all_parents_done(con, child_id):
    return all(s == "done" for _, s in parent_statuses(con, child_id))


def promote_children(con, actor, parent_id):
    """Promote todo children of parent_id whose parents are all done."""
    kids = con.execute("SELECT child_id FROM links WHERE parent_id=?", (parent_id,)).fetchall()
    for k in kids:
        cid = k["child_id"]
        t = con.execute("SELECT status FROM tasks WHERE id=?", (cid,)).fetchone()
        if t and t["status"] == "todo" and all_parents_done(con, cid):
            con.execute(
                "UPDATE tasks SET status='ready', updated_at=? WHERE id=?", (now_iso(), cid)
            )
            emit(con, actor, "promoted", cid, reason=f"all parents done (incl. {parent_id})")


def recheck_promotion(con, actor, child_id):
    t = con.execute("SELECT status FROM tasks WHERE id=?", (child_id,)).fetchone()
    if t and t["status"] == "todo" and all_parents_done(con, child_id):
        con.execute("UPDATE tasks SET status='ready', updated_at=? WHERE id=?", (now_iso(), child_id))
        emit(con, actor, "promoted", child_id, reason="all parents done")


def touch(con, task_id):
    con.execute("UPDATE tasks SET updated_at=? WHERE id=?", (now_iso(), task_id))


def die(msg, code=1):
    print(f"swrm: error: {msg}", file=sys.stderr)
    sys.exit(code)


def out(args, human, data):
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        print(human)


# ---------------------------------------------------------------- commands

def cmd_init(args):
    path = resolve_db(args)
    con = connect(path)
    con.close()
    out(args, f"initialized board at {path}", {"db": path})


def cmd_add(args):
    con = connect(resolve_db(args))
    actor = resolve_actor(args)
    parents = args.parent or []
    con.execute("BEGIN IMMEDIATE")
    try:
        for p in parents:
            get_task(con, p)
        tid = new_id()
        ts = now_iso()
        if args.status:
            status = args.status
        elif parents and not all(s == "done" for p in parents for s in [con.execute("SELECT status FROM tasks WHERE id=?", (p,)).fetchone()["status"]]):
            status = "todo"
        else:
            status = "ready"
        labels = ",".join(args.label or [])
        con.execute(
            "INSERT INTO tasks (id, title, body, status, priority, assignee, labels, created_at, updated_at)"
            " VALUES (?,?,?,?,?,?,?,?,?)",
            (tid, args.title, args.body or "", status, args.priority, args.assignee or "", labels, ts, ts),
        )
        for p in parents:
            con.execute("INSERT INTO links (parent_id, child_id) VALUES (?,?)", (p, tid))
        emit(con, actor, "created", tid, title=args.title, status=status,
             assignee=args.assignee or "", priority=args.priority, parents=parents)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    task = get_task(con, tid)
    con.close()
    out(args, f"created {tid} [{status}] {args.title}", task)


def _filter_query(args):
    q = "SELECT * FROM tasks WHERE status != 'archived'"
    params = []
    if args.status:
        q += " AND status=?"
        params.append(args.status)
    if args.assignee:
        q += " AND assignee=?"
        params.append(args.assignee)
    if args.label:
        q += " AND (',' || labels || ',') LIKE ?"
        params.append(f"%,{args.label},%")
    q += " ORDER BY priority DESC, created_at ASC"
    return q, params


def cmd_ls(args):
    con = connect(resolve_db(args))
    q, params = _filter_query(args)
    rows = [row_to_task(r) for r in con.execute(q, params).fetchall()]
    con.close()
    if args.json:
        out(args, "", rows)
        return
    if not rows:
        print("(no tasks)")
        return
    for t in rows:
        labels = f" #{','.join(t['labels'])}" if t["labels"] else ""
        claim = f" claimed-by:{t['claimed_by']}" if t["status"] == "doing" else ""
        assignee = f" @{t['assignee']}" if t["assignee"] else ""
        print(f"{t['id']}  [{t['status']:<7}] P{t['priority']}  {t['title']}{assignee}{claim}{labels}")


def cmd_board(args):
    con = connect(resolve_db(args))
    rows = con.execute(
        "SELECT * FROM tasks WHERE status != 'archived' ORDER BY priority DESC, created_at ASC"
    ).fetchall()
    con.close()
    tasks = [row_to_task(r) for r in rows]
    if args.json:
        out(args, "", {s: [t for t in tasks if t["status"] == s] for s in STATUSES if s != "archived"})
        return
    for s in ["todo", "ready", "doing", "blocked", "done"]:
        col = [t for t in tasks if t["status"] == s]
        print(f"== {s} ({len(col)}) " + "=" * max(0, 50 - len(s)))
        for t in col:
            assignee = f" @{t['assignee']}" if t["assignee"] else ""
            claim = f" (claimed by {t['claimed_by']})" if t["status"] == "doing" else ""
            print(f"  {t['id']}  P{t['priority']}  {t['title']}{assignee}{claim}")
        if not col:
            print("  (empty)")


def cmd_show(args):
    con = connect(resolve_db(args))
    t = get_task(con, args.id)
    parents = [r["parent_id"] for r in con.execute("SELECT parent_id FROM links WHERE child_id=?", (args.id,))]
    children = [r["child_id"] for r in con.execute("SELECT child_id FROM links WHERE parent_id=?", (args.id,))]
    events = [
        dict(r) for r in con.execute(
            "SELECT id, ts, actor, action, details FROM events WHERE task_id=? ORDER BY id", (args.id,)
        )
    ]
    con.close()
    t["parents"] = parents
    t["children"] = children
    t["history"] = events
    if args.json:
        out(args, "", t)
        return
    print(f"{t['id']}  [{t['status']}]  P{t['priority']}  {t['title']}")
    if t["assignee"]:
        print(f"  assignee: {t['assignee']}")
    if t["labels"]:
        print(f"  labels:   {', '.join(t['labels'])}")
    if t["status"] == "doing":
        print(f"  claimed:  by {t['claimed_by']} at {t['claimed_at']} (expires {t['claim_expires_at']})")
    if t["result"]:
        print(f"  result:   {t['result']}")
    if t["body"]:
        print(f"  body:\n    " + t["body"].replace("\n", "\n    "))
    if parents:
        print(f"  parents:  {', '.join(parents)}")
    if children:
        print(f"  children: {', '.join(children)}")
    print(f"  created {t['created_at']}  updated {t['updated_at']}")
    if events:
        print("  history:")
        for e in events:
            print(f"    #{e['id']} {e['ts']} {e['actor']} {e['action']} {e['details']}")


def _set_status(args, task_id, status, result=None, result_key="result"):
    con = connect(resolve_db(args))
    actor = resolve_actor(args)
    con.execute("BEGIN IMMEDIATE")
    try:
        t = get_task(con, task_id)
        old = t["status"]
        res = result if result is not None else t["result"]
        con.execute(
            "UPDATE tasks SET status=?, result=?, updated_at=?, claimed_by='', claimed_at='', claim_expires_at=? WHERE id=?",
            (status, res, now_iso(), "", task_id),
        )
        emit(con, actor, status, task_id, prev=old, **({result_key: res} if res else {}))
        if status == "done":
            promote_children(con, actor, task_id)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    t = get_task(con, task_id)
    con.close()
    return t


def cmd_move(args):
    if args.status not in STATUSES:
        die(f"status must be one of: {', '.join(STATUSES)}", 2)
    t = _set_status(args, args.id, args.status)
    out(args, f"{t['id']} -> {args.status}", t)


def cmd_complete(args):
    t = _set_status(args, args.id, "done", result=args.summary or "", result_key="summary")
    out(args, f"{t['id']} done", t)


def cmd_block(args):
    t = _set_status(args, args.id, "blocked", result=args.reason or "", result_key="reason")
    out(args, f"{t['id']} blocked", t)


def cmd_unblock(args):
    t = _set_status(args, args.id, "ready")
    out(args, f"{t['id']} -> ready", t)


def cmd_claim(args):
    con = connect(resolve_db(args))
    actor = resolve_actor(args)
    ttl = args.ttl if args.ttl is not None else DEFAULT_CLAIM_TTL
    con.execute("BEGIN IMMEDIATE")
    try:
        if args.any:
            q = "SELECT id FROM tasks WHERE status='ready'"
            params = []
            if args.assignee:
                q += " AND assignee=?"
                params.append(args.assignee)
            q += " ORDER BY priority DESC, created_at ASC LIMIT 1"
            r = con.execute(q, params).fetchone()
            if not r:
                con.execute("ROLLBACK")
                con.close()
                die("no claimable ready task" + (f" for assignee '{args.assignee}'" if args.assignee else ""), 1)
            task_id = r["id"]
        else:
            task_id = args.id
            get_task(con, task_id)
        exp = (datetime.now(timezone.utc) + timedelta(seconds=ttl)).isoformat(timespec="milliseconds").replace("+00:00", "Z")
        cur = con.execute(
            "UPDATE tasks SET status='doing', claimed_by=?, claimed_at=?, claim_expires_at=?, updated_at=?"
            " WHERE id=? AND status='ready'",
            (actor, now_iso(), exp, now_iso(), task_id),
        )
        if cur.rowcount == 0:
            con.execute("ROLLBACK")
            con.close()
            die(f"{task_id} is not in 'ready' (already claimed or moved)", 1)
        emit(con, actor, "claimed", task_id, ttl_seconds=ttl, expires=exp)
        con.execute("COMMIT")
    except Exception:
        try:
            con.execute("ROLLBACK")
        except sqlite3.Error:
            pass
        raise
    t = get_task(con, task_id)
    con.close()
    out(args, f"claimed {t['id']} by {actor} (expires {t['claim_expires_at']})", t)


def cmd_release(args):
    con = connect(resolve_db(args))
    actor = resolve_actor(args)
    con.execute("BEGIN IMMEDIATE")
    try:
        t = get_task(con, args.id)
        if t["status"] != "doing":
            con.execute("ROLLBACK")
            con.close()
            die(f"{args.id} is not claimed (status={t['status']})", 1)
        if t["claimed_by"] != actor and not args.force:
            con.execute("ROLLBACK")
            con.close()
            die(f"{args.id} is claimed by {t['claimed_by']}, not you ({actor}); use --force", 1)
        con.execute(
            "UPDATE tasks SET status='ready', claimed_by='', claimed_at='', claim_expires_at='', updated_at=? WHERE id=?",
            (now_iso(), args.id),
        )
        emit(con, actor, "released", args.id, prev_claim=t["claimed_by"])
        con.execute("COMMIT")
    except Exception:
        try:
            con.execute("ROLLBACK")
        except sqlite3.Error:
            pass
        raise
    t = get_task(con, args.id)
    con.close()
    out(args, f"released {t['id']} -> ready", t)


def cmd_reclaim(args):
    """Release expired claims (or one specific task with --force)."""
    con = connect(resolve_db(args))
    actor = resolve_actor(args)
    con.execute("BEGIN IMMEDIATE")
    try:
        now = now_iso()
        if args.id:
            t = get_task(con, args.id)
            if t["status"] != "doing":
                con.execute("ROLLBACK")
                con.close()
                die(f"{args.id} is not claimed (status={t['status']})", 1)
            if not args.force and t["claim_expires_at"] >= now:
                con.execute("ROLLBACK")
                con.close()
                die(f"{args.id} claim not expired yet (expires {t['claim_expires_at']}); use --force", 1)
            ids = [(args.id, t["claimed_by"])]
        else:
            rows = con.execute(
                "SELECT id, claimed_by FROM tasks WHERE status='doing' AND claim_expires_at < ?", (now,)
            ).fetchall()
            ids = [(r["id"], r["claimed_by"]) for r in rows]
        for tid, owner in ids:
            con.execute(
                "UPDATE tasks SET status='ready', claimed_by='', claimed_at='', claim_expires_at='', updated_at=? WHERE id=?",
                (now_iso(), tid),
            )
            emit(con, actor, "reclaimed", tid, prev_claim=owner, reason="claim expired" if not args.force else "forced")
        con.execute("COMMIT")
    except Exception:
        try:
            con.execute("ROLLBACK")
        except sqlite3.Error:
            pass
        raise
    con.close()
    if args.json:
        out(args, "", [{"id": i, "prev_claim": o} for i, o in ids])
    else:
        for i, o in ids:
            print(f"reclaimed {i} (was claimed by {o}) -> ready")
        if not ids:
            print("(no expired claims)")


