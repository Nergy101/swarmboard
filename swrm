def cmd_rm(args):
    if args.all and args.id:
        die("use either an id/status or --all, not both", 2)
    if not args.all and not args.id:
        die("rm needs a task id, a status name (e.g. 'swrm rm done'), or --all", 2)
    if args.id in STATUSES and args.id == "archived":
        die("archived cards are already hidden from the board; use 'swrm prune' to delete them", 2)

    con = connect(resolve_db(args))
    actor = resolve_actor(args)
    con.execute("BEGIN IMMEDIATE")
    try:
        if args.all:
            rows = con.execute("SELECT * FROM tasks WHERE status != 'archived'").fetchall()
            target = "all"
        elif args.id in STATUSES:
            rows = con.execute("SELECT * FROM tasks WHERE status=?", (args.id,)).fetchall()
            target = args.id
        else:
            rows = [get_task(con, args.id)]
            target = args.id
        ids = []
        for t in rows:
            con.execute("UPDATE tasks SET status='archived', updated_at=? WHERE id=?", (now_iso(), t["id"]))
            emit(con, actor, "archived", t["id"], prev=t["status"])
            ids.append(t["id"])
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    con.close()
    if len(ids) == 1 and target == ids[0]:
        out(args, f"archived {ids[0]}", {"id": ids[0]})
    else:
        out(args, f"archived {len(ids)} cards ({target})", {"archived": ids, "count": len(ids)})


def cmd_prune(args):
    """Permanently delete archived cards, their links, and their events."""
    con = connect(resolve_db(args))
    actor = resolve_actor(args)
    con.execute("BEGIN IMMEDIATE")
    try:
        ids = [r["id"] for r in con.execute("SELECT id FROM tasks WHERE status='archived'").fetchall()]
        if args.dry_run:
            con.execute("ROLLBACK")
        else:
            for tid in ids:
                con.execute("DELETE FROM links WHERE parent_id=? OR child_id=?", (tid, tid))
                con.execute("DELETE FROM events WHERE task_id=?", (tid,))
                con.execute("DELETE FROM tasks WHERE id=?", (tid,))
            emit(con, actor, "pruned", None, count=len(ids), ids=ids)
            con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    con.close()
    verb = "would prune" if args.dry_run else "pruned"
    out(args, f"{verb} {len(ids)} archived cards", {"count": len(ids), "ids": ids, "dry_run": args.dry_run})


def cmd_events(args):
    con = connect(resolve_db(args))
    q = "SELECT id, ts, actor, action, task_id, details FROM events"
    params = []
    if args.task:
        q += " WHERE task_id=?"
        params.append(args.task)
    q += " ORDER BY id DESC LIMIT ?"
    params.append(args.limit)
    rows = [dict(r) for r in con.execute(q, params).fetchall()]
    con.close()
    rows.reverse()
    if args.json:
        out(args, "", rows)
        return
    for e in rows:
        print(f"#{e['id']:<6} {e['ts']}  {e['actor']:<12} {e['action']:<10} {e['task_id'] or '-':<10} {e['details']}")


def cmd_watch(args):
    """Stream the change feed live. Ctrl-C to stop."""
    con = connect(resolve_db(args))
    last = args.since
    if last is None:
        r = con.execute("SELECT COALESCE(MAX(id), 0) AS m FROM events").fetchone()
        last = r["m"]
    if not args.json:
        print(f"watching {resolve_db(args)} (feed from event #{last + 1}); Ctrl-C to stop", file=sys.stderr)
    try:
        while True:
            rows = con.execute(
                "SELECT id, ts, actor, action, task_id, details FROM events WHERE id > ? ORDER BY id",
                (last,),
            ).fetchall()
            for r in rows:
                last = r["id"]
                if args.json:
                    print(json.dumps(dict(r), ensure_ascii=False), flush=True)
                else:
                    print(f"#{r['id']:<6} {r['ts']}  {r['actor']:<12} {r['action']:<10} {r['task_id'] or '-':<10} {r['details']}", flush=True)
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass
    finally:
        con.close()


# ---------------------------------------------------------------- dashboard

STATUS_COLORS = {
    "todo": "\033[33m",    # yellow
    "ready": "\033[32m",   # green
    "doing": "\033[36m",   # cyan
    "blocked": "\033[31m", # red
    "done": "\033[2m",     # dim
}
RESET = "\033[0m"


def _truncate(s, w):
    if w <= 3:
        return s[:w]
    return s if len(s) <= w else s[: w - 3] + "..."


def _fmt_remaining(expires_iso):
    try:
        exp = datetime.fromisoformat(expires_iso.replace("Z", "+00:00"))
        secs = int((exp - datetime.now(timezone.utc)).total_seconds())
    except Exception:
        return "?"
    if secs < 0:
        return "EXPIRED"
    m, s = divmod(secs, 60)
    return f"{m}m{s:02d}s" if m else f"{s}s"


CARD_H = 4  # each board cell is a bordered card: top border, title, meta, bottom border


def _task_card(t, col_w):
    """Content lines of a card (without the border): human-readable title first,
    then a dim meta line with id/priority/worker."""
    inner = col_w - 2
    meta = f"{t['id']} P{t['priority']}"
    if t["status"] == "doing" and t["claimed_by"]:
        meta += f" [{t['claimed_by']} {_fmt_remaining(t['claim_expires_at'])}]"
    elif t["assignee"]:
        meta += f" @{t['assignee']}"
    return [_truncate(t["title"], inner), _truncate(meta, inner)]


def _board_columns(width):
    cols = ["todo", "ready", "doing", "blocked"]
    if width >= 100:
        cols.append("done")
    n = len(cols)
    col_w = max(16, (width - (n - 1)) // n)
    return cols, col_w


def _column_tasks(tasks, cols):
    col_tasks = {}
    for s in cols:
        ts = [t for t in tasks if t["status"] == s]
        if s == "done":
            ts = sorted(ts, key=lambda t: t["updated_at"], reverse=True)
        col_tasks[s] = ts
    return col_tasks


def render_frame(tasks, events, title, feed_lines):
    width, height = shutil.get_terminal_size((100, 30))
    width = max(60, width)
    no_color = bool(os.environ.get("NO_COLOR"))
    C = STATUS_COLORS if not no_color else {k: "" for k in STATUS_COLORS}
    R = "" if no_color else RESET

    counts = {s: sum(1 for t in tasks if t["status"] == s) for s in STATUSES}

    lines = []
    lines.append(_truncate(f" KANBAN {title}   {now_iso()}", width))
    counts_str = "  ".join(f"{C[s]}{s}:{counts.get(s, 0)}{R}" for s in ["todo", "ready", "doing", "blocked", "done"])
    lines.append(counts_str)
    lines.append("-" * width)

    cols, col_w = _board_columns(width)
    col_tasks = _column_tasks(tasks, cols)

    # 7 chrome lines (title, counts, dash, header, dash, dash, FEED label) must
    # fit inside the terminal together with the cards and the feed, otherwise
    # the frame overflows and the top lines (incl. column headers) scroll off.
    slots = max(1, (height - 7 - len(events)) // CARD_H)
    header_cells = [C[s] + _truncate(f"{s.upper()} ({counts.get(s, 0)})", col_w).ljust(col_w) + R for s in cols]
    lines.append(" ".join(header_cells))
    lines.append(" ".join("-" * col_w for _ in cols))
    dim = "\033[2m" if not no_color else ""
    for i in range(slots):
        for li in range(CARD_H):
            cells = []
            for s in cols:
                ts = col_tasks[s]
                if i < len(ts):
                    card = _task_card(ts[i], col_w)
                    if li == 0:
                        cells.append(C[s] + "┌" + "─" * (col_w - 2) + "┐" + R)
                    elif li == CARD_H - 1:
                        cells.append(C[s] + "└" + "─" * (col_w - 2) + "┘" + R)
                    else:
                        txt = "│" + card[li - 1].ljust(col_w - 2) + "│"
                        cells.append(dim + txt + R if li == CARD_H - 2 else txt)
                else:
                    cells.append(" " * col_w)
            lines.append(" ".join(cells).rstrip())

    lines.append("-" * width)
    lines.append(" FEED (latest events)")
    for e in events:
        ts = e["ts"][11:19] if len(e["ts"]) >= 19 else e["ts"]
        line = f"#{e['id']} {ts} {e['actor']} {e['action']} {e['task_id'] or '-'} {e['details']}"
        lines.append(_truncate(line, width))
    return "\n".join(lines)


def _wrap_lines(text, width):
    import textwrap
    out = []
    for para in text.split("\n"):
        out.extend(textwrap.wrap(para, width) or [""])
    return out


def _modal_lines(t, det):
    lines = [f"{t['id']}  [{t['status']}]  P{t['priority']}  {t['title']}", ""]
    if t.get("assignee"):
        lines.append(f"assignee:  {t['assignee']}")
    if t.get("labels"):
        lines.append(f"labels:    {', '.join(t['labels'])}")
    if t["status"] == "doing" and t.get("claimed_by"):
        lines.append(f"claimed:   by {t['claimed_by']} at {t['claimed_at']} "
                     f"(expires {t['claim_expires_at']}, {_fmt_remaining(t['claim_expires_at'])} left)")
    if t.get("result"):
        lines.append(f"result:    {t['result']}")
    lines.append(f"created:   {t['created_at']}")
    lines.append(f"updated:   {t['updated_at']}")
    if det:
        if det.get("parents"):
            lines.append(f"parents:   {', '.join(det['parents'])}")
        if det.get("children"):
            lines.append(f"children:  {', '.join(det['children'])}")
    if t.get("body"):
        lines.append("")
        lines.append("body:")
        lines.extend("  " + l for l in _wrap_lines(t["body"], 64))
    if det and det.get("history"):
        lines.append("")
        lines.append("history:")
        for e in det["history"]:
            ts = e["ts"][11:19] if len(e["ts"]) >= 19 else e["ts"]
            lines.append(f"  #{e['id']} {ts} {e['actor']} {e['action']} {e['details']}")
    return lines


def _box(win, y, x, h, w, attr=0):
    """Draw a bordered box on a curses window using ACS line chars."""
    import curses
    win.addch(y, x, curses.ACS_ULCORNER, attr)
    win.addch(y, x + w - 1, curses.ACS_URCORNER, attr)
    win.addch(y + h - 1, x, curses.ACS_LLCORNER, attr)
    win.addch(y + h - 1, x + w - 1, curses.ACS_LRCORNER, attr)
    for k in range(1, w - 1):
        win.addch(y, x + k, curses.ACS_HLINE, attr)
        win.addch(y + h - 1, x + k, curses.ACS_HLINE, attr)
    for k in range(1, h - 1):
        win.addch(y + k, x, curses.ACS_VLINE, attr)
        win.addch(y + k, x + w - 1, curses.ACS_VLINE, attr)


def _draw_modal(stdscr, t, det, attrs, off):
    """Draw the centered detail popup directly on stdscr (no subwindow — a
    subwindow's refresh makes curses.getmouse() fail with ERR). The main loop
    redraws the whole board each frame anyway. Returns (scroll offset, rect)."""
    import curses
    h, w = stdscr.getmaxyx()
    content = _modal_lines(t, det)
    mw = min(76, max(44, w - 4))
    mh = max(8, min(h - 2, len(content) + 4))
    win_y, win_x = (h - mh) // 2, (w - mw) // 2
    maxvis = mh - 3
    off = min(off, max(0, len(content) - maxvis))
    _box(stdscr, win_y, win_x, mh, mw, attrs.get(t["status"], 0))
    stdscr.addnstr(win_y, win_x + 2, f" {t['id']} ", mw - 4, attrs.get(t["status"], 0) | curses.A_BOLD)
    for i in range(maxvis):
        if off + i < len(content):
            stdscr.addnstr(win_y + 1 + i, win_x + 2, content[off + i][: mw - 4], mw - 4)
    if len(content) > maxvis:
        stdscr.addnstr(win_y + mh - 1, win_x + 2,
                       f" {off + 1}-{min(off + maxvis, len(content))}/{len(content)}  up/down scroll, q close ", mw - 4, curses.A_DIM)
    return off, (win_x, win_y, mw, mh)


def _curses_dash(snap, title, args, detail=None):
    """Full-screen dashboard TUI: column headers and feed stay pinned. Move the
    cursor with arrows or hjkl, open a card's detail modal with Enter or a mouse
    click, q or Ctrl-C quits. Falls back to the plain frame loop if curses is
    unavailable."""
    os.environ.setdefault("ESCDELAY", "25")  # snappy arrow-key parsing
    import curses

    def main(stdscr):
        curses.curs_set(0)
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
        stdscr.timeout(max(100, int(args.interval * 1000)))
        if not os.environ.get("NO_COLOR") and curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            color_map = {"todo": curses.COLOR_YELLOW, "ready": curses.COLOR_GREEN,
                         "doing": curses.COLOR_CYAN, "blocked": curses.COLOR_RED}
            attrs = {"done": curses.A_DIM}
            for i, (s, c) in enumerate(color_map.items(), start=1):
                curses.init_pair(i, c, -1)
                attrs[s] = curses.color_pair(i)
        else:
            attrs = {s: 0 for s in STATUS_COLORS}

        sel_col = 0
        sel_row = 0
        offset = 0
        modal = None   # {"t": task, "det": detail-dict} while a card popup is open
        moff = 0       # popup scroll offset
        mrect = None   # popup rect (x, y, w, h)
        while True:
            tasks, events = snap()
            h, w = stdscr.getmaxyx()
            w = max(60, w)
            feed_n = min(args.feed, max(0, h - 12))
            top = 5                                   # title, counts, dash, header, dash
            bot = h - 2 - feed_n                      # dash, FEED label, feed lines
            slots = max(1, (bot - top) // CARD_H)     # visible mini-cards per column

            counts = {s: sum(1 for t in tasks if t["status"] == s) for s in STATUSES}
            cols, col_w = _board_columns(w)
            col_tasks = _column_tasks(tasks, cols)

            max_len = max((len(ts) for ts in col_tasks.values()), default=0)
            sel_col = min(sel_col, len(cols) - 1)
            sel_row = min(sel_row, max(0, max_len - 1))
            if sel_row < offset:
                offset = sel_row
            if sel_row >= offset + slots:
                offset = sel_row - slots + 1

            def pick(mx, my):
                """Map a screen click to a card, or None."""
                if top <= my < bot:
                    ci = min(len(cols) - 1, mx // (col_w + 1))
                    r = offset + (my - top) // CARD_H
                    ts = col_tasks[cols[ci]]
                    if r < len(ts):
                        return ts[r]
                return None

            def open_modal(t):
                nonlocal modal, moff
                modal = {"t": t, "det": detail(t["id"]) if detail else None}
                moff = 0

            def close_modal():
                nonlocal modal
                modal = None

            stdscr.erase()
            stdscr.addnstr(0, 0, _truncate(f" KANBAN {title}   {now_iso()}", w), w - 1)
            x = 1
            for s in ["todo", "ready", "doing", "blocked", "done"]:
                txt = f"{s}:{counts.get(s, 0)}  "
                stdscr.addnstr(1, x, txt, w - 1 - x, attrs.get(s, 0))
                x += len(txt)
            stdscr.addnstr(2, 0, "-" * (w - 1), w - 1)
            x = 0
            for s in cols:
                stdscr.addnstr(3, x, _truncate(f"{s.upper()} ({counts.get(s, 0)})", col_w), col_w, attrs.get(s, 0))
                x += col_w + 1
            x = 0
            for _ in cols:
                stdscr.addnstr(4, x, "-" * col_w, col_w)
                x += col_w + 1
            for i in range(slots):
                for li in range(CARD_H):
                    x = 0
                    for ci, s in enumerate(cols):
                        ts = col_tasks[s]
                        j = offset + i
                        y = top + i * CARD_H + li
                        sel = ci == sel_col and j == sel_row and j < len(ts)
                        if j < len(ts):
                            card = _task_card(ts[j], col_w)
                            if sel:
                                attr = curses.A_REVERSE
                            elif li in (0, CARD_H - 1):
                                attr = attrs.get(s, 0)
                            elif li == CARD_H - 2:
                                attr = curses.A_DIM
                            else:
                                attr = 0
                            if li == 0:
                                stdscr.addch(y, x, curses.ACS_ULCORNER, attr)
                                for k in range(1, col_w - 1):
                                    stdscr.addch(y, x + k, curses.ACS_HLINE, attr)
                                stdscr.addch(y, x + col_w - 1, curses.ACS_URCORNER, attr)
                            elif li == CARD_H - 1:
                                stdscr.addch(y, x, curses.ACS_LLCORNER, attr)
                                for k in range(1, col_w - 1):
                                    stdscr.addch(y, x + k, curses.ACS_HLINE, attr)
                                stdscr.addch(y, x + col_w - 1, curses.ACS_LRCORNER, attr)
                            else:
                                stdscr.addch(y, x, curses.ACS_VLINE, attr)
                                # ljust so the padding cells get the attr too — otherwise
                                # a selected card shows a black hole where there's no text
                                stdscr.addnstr(y, x + 1, card[li - 1].ljust(col_w - 2), col_w - 2, attr)
                                stdscr.addch(y, x + col_w - 1, curses.ACS_VLINE, attr)
                        x += col_w + 1
            stdscr.addnstr(bot, 0, "-" * (w - 1), w - 1)
            stdscr.addnstr(bot + 1, 0, " FEED (latest events)   [enter/click: card details · click another card: switch · arrows/hjkl: move · q: quit]", w - 1)
            for i, e in enumerate(events[:feed_n]):
                ts = e["ts"][11:19] if len(e["ts"]) >= 19 else e["ts"]
                line = f"#{e['id']} {ts} {e['actor']} {e['action']} {e['task_id'] or '-'} {e['details']}"
                stdscr.addnstr(bot + 2 + i, 0, _truncate(line, w - 1), w - 1)
            if modal is not None:
                moff, mrect = _draw_modal(stdscr, modal["t"], modal["det"], attrs, moff)
            stdscr.refresh()

            ch = stdscr.getch()
            if modal is not None:
                # popup open: q/Esc/Enter closes, up/down scroll it, a click
                # outside it closes it — or switches to the clicked card
                if ch in (ord("q"), 27, 10, 13, curses.KEY_ENTER):
                    close_modal()
                elif ch in (curses.KEY_UP, ord("k")):
                    moff = max(0, moff - 1)
                elif ch in (curses.KEY_DOWN, ord("j")):
                    moff += 1
                elif ch == curses.KEY_MOUSE and mrect:
                    try:
                        _, mx, my, _, bstate = curses.getmouse()
                    except curses.error:
                        continue
                    if bstate & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED):
                        wx, wy, ww, wh = mrect
                        if wx <= mx < wx + ww and wy <= my < wy + wh:
                            pass  # click inside the popup: ignore
                        else:
                            t = pick(mx, my)
                            if t is not None:
                                sel_col = min(len(cols) - 1, mx // (col_w + 1))
                                sel_row = offset + (my - top) // CARD_H
                                open_modal(t)   # switch the popup to the clicked card
                            else:
                                close_modal()    # clicked outside any card: close
                elif ch == curses.KEY_RESIZE:
                    pass
                continue
            if ch in (ord("q"), 3):  # q or Ctrl-C
                break
            if ch in (curses.KEY_UP, ord("k")):
                sel_row = max(0, sel_row - 1)
            elif ch in (curses.KEY_DOWN, ord("j")):
                sel_row += 1
            elif ch in (curses.KEY_LEFT, ord("h")):
                sel_col = max(0, sel_col - 1)
            elif ch in (curses.KEY_RIGHT, ord("l")):
                sel_col = min(len(cols) - 1, sel_col + 1)
            elif ch in (10, 13, curses.KEY_ENTER):
                ts = col_tasks[cols[sel_col]]
                if sel_row < len(ts):
                    open_modal(ts[sel_row])
            elif ch == curses.KEY_MOUSE:
                try:
                    _, mx, my, _, bstate = curses.getmouse()
                except curses.error:
                    continue
                if bstate & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED):
                    t = pick(mx, my)
                    if t is not None:
                        sel_col = min(len(cols) - 1, mx // (col_w + 1))
                        sel_row = offset + (my - top) // CARD_H
                        open_modal(t)
            elif ch == curses.KEY_RESIZE:
                pass  # redrawn on next loop iteration

    curses.wrapper(main)


def cmd_dash(args):
    path = resolve_db(args)
    con = connect(path)

    def snap():
        tasks = [row_to_task(r) for r in con.execute(
            "SELECT * FROM tasks WHERE status != 'archived' ORDER BY priority DESC, created_at ASC"
        ).fetchall()]
        events = [dict(r) for r in con.execute(
            "SELECT id, ts, actor, action, task_id, details FROM events ORDER BY id DESC LIMIT ?",
            (args.feed,),
        ).fetchall()]
        events.reverse()
        return tasks, events

    def detail(tid):
        r = con.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone()
        if not r:
            return None
        t = dict(row_to_task(r))
        t["parents"] = [x["parent_id"] for x in con.execute("SELECT parent_id FROM links WHERE child_id=?", (tid,))]
        t["children"] = [x["child_id"] for x in con.execute("SELECT child_id FROM links WHERE parent_id=?", (tid,))]
        t["history"] = [dict(x) for x in con.execute(
            "SELECT id, ts, actor, action, details FROM events WHERE task_id=? ORDER BY id", (tid,))]
        return t

    is_tty = sys.stdout.isatty()
    follow = args.follow or (is_tty and not args.once)
    if not follow:
        tasks, events = snap()
        print(render_frame(tasks, events, path, args.feed))
        con.close()
        return
    if is_tty:
        try:
            _curses_dash(snap, path, args, detail)
        except Exception:
            pass  # curses unavailable/broken — fall back to the plain frame loop
        else:
            con.close()
            return
    out = sys.stdout
    if is_tty:
        out.write("\033[?1049h\033[?25l")  # alternate screen, hide cursor
        out.flush()
    try:
        while True:
            tasks, events = snap()
            frame = render_frame(tasks, events, path, args.feed)
            if is_tty:
                out.write("\033[H\033[2J" + frame + "\n")
            else:
                out.write(f"\n---------- frame {now_iso()} ----------\n" + frame + "\n")
            out.flush()
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass
    finally:
        if is_tty:
            out.write("\033[?25h\033[?1049l\n")
            out.flush()
        con.close()


# ---------------------------------------------------------------- leader-follower (HTTP)
#
# Leader:  swrm serve --host 0.0.0.0 --port 8765     (owns the SQLite db)
# Follower: export KANBAN_URL=http://leader:8765       (CLI talks HTTP instead of SQLite)
#
# The server runs the exact same command functions in-process, so all atomicity
# guarantees hold on the leader. Followers are thin clients; watch/dash long-poll
# GET /events?since=N.

def _cmd_namespace(name):
    """Build the argparse namespace (with func) for a subcommand without parsing argv."""
    p = build_parser()
    choices = p._subparsers._group_actions[0].choices
    sp = choices.get(name)
    if sp is None:
        return None
    ns = argparse.Namespace(cmd=name)
    for k, v in sp._defaults.items():
        setattr(ns, k, v)
    return ns


def run_cmd_on_server(name, payload, db_path):
    if name in ("watch", "dash", "dashboard", "live", "serve"):
        return 2, "", f"'{name}' is client-side only; use GET /events or GET /snapshot"
    ns = _cmd_namespace(name)
    if ns is None:
        return 2, "", f"unknown command: {name}"
    for k, v in payload.items():
        if k in ("func", "cmd", "url"):
            continue
        setattr(ns, k, v)
    ns.db = db_path  # the leader owns the database; ignore any client --db
    buf, err = io.StringIO(), io.StringIO()
    old_out, old_err = sys.stdout, sys.stderr
    sys.stdout, sys.stderr = buf, err
    code = 0
    try:
        ns.func(ns)
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else 1
    finally:
        sys.stdout, sys.stderr = old_out, old_err
    return code, buf.getvalue(), err.getvalue()


def _events_since(db_path, since, timeout, max_only=0):
    if max_only:
        con = connect(db_path, create=False)
        rows = [dict(r) for r in con.execute(
            "SELECT id, ts, actor, action, task_id, details FROM events ORDER BY id DESC LIMIT ?",
            (max_only,),
        )]
        con.close()
        rows.reverse()
        return rows
    deadline = time.time() + timeout
    while True:
        con = connect(db_path, create=False)
        rows = [dict(r) for r in con.execute(
            "SELECT id, ts, actor, action, task_id, details FROM events WHERE id > ? ORDER BY id",
            (since,),
        )]
        con.close()
        if rows or time.time() >= deadline:
            return rows
        time.sleep(0.2)


def _snapshot(db_path, feed_lines):
    con = connect(db_path, create=False)
    tasks = [row_to_task(r) for r in con.execute(
        "SELECT * FROM tasks WHERE status != 'archived' ORDER BY priority DESC, created_at ASC"
    ).fetchall()]
    events = [dict(r) for r in con.execute(
        "SELECT id, ts, actor, action, task_id, details FROM events ORDER BY id DESC LIMIT ?",
        (feed_lines,),
    ).fetchall()]
    con.close()
    events.reverse()
    return {"tasks": tasks, "events": events, "db": db_path, "now": now_iso()}


class KanbanHandler(BaseHTTPRequestHandler):
    db_path = None
    passkey = None  # when set, every request must carry X-Swrm-Passkey

    def log_message(self, *a):
        pass

    def _send_json(self, obj, code=200):
        body = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _authorized(self):
        if not KanbanHandler.passkey:
            return True
        return self.headers.get("X-Swrm-Passkey") == KanbanHandler.passkey

    def do_GET(self):
        if not self._authorized():
            self._send_json({"error": "unauthorized: bad or missing passkey"}, 401)
            return
        u = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(u.query)
        if u.path == "/health":
            self._send_json({"ok": True, "db": self.db_path})
        elif u.path == "/events":
            since = int(q.get("since", ["0"])[0])
            timeout = min(float(q.get("timeout", ["25"])[0]), 60.0)
            max_only = int(q.get("max", ["0"])[0])
            self._send_json({"events": _events_since(self.db_path, since, timeout, max_only)})
        elif u.path == "/snapshot":
            feed = int(q.get("feed", ["8"])[0])
            self._send_json(_snapshot(self.db_path, feed))
        else:
            self._send_json({"error": "not found"}, 404)

    def do_POST(self):
        if not self._authorized():
            self._send_json({"error": "unauthorized: bad or missing passkey"}, 401)
            return
        if self.path.startswith("/cmd/"):
            name = urllib.parse.unquote(self.path[len("/cmd/"):])
            length = int(self.headers.get("Content-Length", 0))
            try:
                payload = json.loads(self.rfile.read(length) or b"{}")
            except json.JSONDecodeError:
                self._send_json({"code": 2, "stdout": "", "stderr": "bad json body"}, 400)
                return
            try:
                code, out, err = run_cmd_on_server(name, payload, self.db_path)
            except Exception as e:
                import traceback
                code, out, err = 1, "", traceback.format_exc()
            self._send_json({"code": code, "stdout": out, "stderr": err})
        else:
            self._send_json({"error": "not found"}, 404)


def cmd_serve(args):
    path = resolve_db(args)
    connect(path)  # ensure schema exists
    KanbanHandler.db_path = path
    KanbanHandler.passkey = args.passkey or os.environ.get("KANBAN_PASSKEY") or None
    srv = ThreadingHTTPServer((args.host, args.port), KanbanHandler)
    print(f"swarmboard leader serving {path}")
    print(f"  http://{args.host}:{args.port}  (Ctrl-C to stop)")
    print(f"  passkey: {'set' if KanbanHandler.passkey else 'NOT set (open API, trusted networks only)'}")
    print(f"followers: export KANBAN_URL=http://<this-host>:{args.port}" +
          (" KANBAN_PASSKEY=<same-secret>" if KanbanHandler.passkey else ""))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()


# ---------------------------------------------------------------- remote client

def _passkey(args):
    return getattr(args, "passkey", None) or os.environ.get("KANBAN_PASSKEY")


def _remote_get(url, path, passkey=None, timeout=70):
    headers = {"X-Swrm-Passkey": passkey} if passkey else {}
    req = urllib.request.Request(url.rstrip("/") + path, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def remote_post(url, args):
    payload = {k: v for k, v in vars(args).items() if k != "func"}
    headers = {"Content-Type": "application/json"}
    pk = _passkey(args)
    if pk:
        headers["X-Swrm-Passkey"] = pk
    req = urllib.request.Request(
        url.rstrip("/") + "/cmd/" + urllib.parse.quote(args.cmd),
        data=json.dumps(payload).encode(),
        headers=headers,
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            res = json.loads(r.read())
    except urllib.error.HTTPError as e:
        if e.code == 401:
            die("unauthorized: leader requires a passkey (set --passkey or $KANBAN_PASSKEY)", 1)
        raise
    if res.get("stdout"):
        sys.stdout.write(res["stdout"])
    if res.get("stderr"):
        sys.stderr.write(res["stderr"])
    sys.exit(res.get("code", 0))


def _print_event(e, as_json):
    if as_json:
        print(json.dumps(e, ensure_ascii=False), flush=True)
    else:
        print(f"#{e['id']:<6} {e['ts']}  {e['actor']:<12} {e['action']:<10} {e['task_id'] or '-':<10} {e['details']}", flush=True)


def remote_watch(args, url):
    since = args.since
    if since is None:
        latest = _remote_get(url, "/events?since=0&max=1&timeout=0", _passkey(args))["events"]
        since = latest[-1]["id"] if latest else 0
    if not args.json:
        print(f"watching {url} (feed from event #{since + 1}); Ctrl-C to stop", file=sys.stderr)
    try:
        while True:
            evs = _remote_get(url, f"/events?since={since}&timeout=25", _passkey(args))["events"]
            for e in evs:
                since = e["id"]
                _print_event(e, args.json)
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass


def remote_dash(args, url):
    is_tty = sys.stdout.isatty()
    follow = args.follow or (is_tty and not args.once)

    def snap():
        s = _remote_get(url, f"/snapshot?feed={args.feed}", _passkey(args))
        return s["tasks"], s["events"]

    def detail(tid):
        headers = {"Content-Type": "application/json"}
        pk = _passkey(args)
        if pk:
            headers["X-Swrm-Passkey"] = pk
        req = urllib.request.Request(
            url.rstrip("/") + "/cmd/show",
            data=json.dumps({"id": tid, "json": True}).encode(),
            headers=headers,
        )
        try:
            with urllib.request.urlopen(req, timeout=10) as r:
                res = json.loads(r.read())
            return json.loads(res["stdout"]) if res.get("stdout") else None
        except Exception:
            return None

    if not follow:
        tasks, events = snap()
        print(render_frame(tasks, events, url, args.feed))
        return
    if is_tty:
        try:
            _curses_dash(snap, url, args, detail)
        except Exception:
            pass  # curses unavailable/broken — fall back to the plain frame loop
        else:
            return
    out = sys.stdout
    if is_tty:
        out.write("\033[?1049h\033[?25l")
        out.flush()
    try:
        while True:
            tasks, events = snap()
            frame = render_frame(tasks, events, url, args.feed)
            if is_tty:
                out.write("\033[H\033[2J" + frame + "\n")
            else:
                out.write(f"\n---------- frame {now_iso()} ----------\n" + frame + "\n")
            out.flush()
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass
    finally:
        if is_tty:
            out.write("\033[?25h\033[?1049l\n")
            out.flush()


# ---------------------------------------------------------------- parser

def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--db", help="path to board database (default: $KANBAN_DB or ./.kanban/kanban.db)")
    common.add_argument("--actor", help="actor name recorded in the feed (default: $KANBAN_ACTOR or $USER)")
    common.add_argument("--json", action="store_true", help="machine-readable JSON output")
    common.add_argument("--url", help="leader URL (default: $KANBAN_URL); when set, commands run remotely over HTTP")
    common.add_argument("--passkey", help="shared secret for leader-follower mode (default: $KANBAN_PASSKEY); sent as X-Swrm-Passkey header")

    p = argparse.ArgumentParser(
        prog="swrm",
        description="CLI-first kanban board for multiple agents, with a live change feed.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("init", parents=[common], help="create the board database").set_defaults(func=cmd_init)

    a = sub.add_parser("add", parents=[common], help="create a task")
    a.add_argument("title")
    a.add_argument("--body", default="")
    a.add_argument("--assignee", default="")
    a.add_argument("--priority", type=int, default=0)
    a.add_argument("--label", action="append", help="repeatable")
    a.add_argument("--parent", action="append", help="parent task id; repeatable. Child starts in 'todo' until all parents are done")
    a.add_argument("--status", choices=STATUSES, help="override initial status")
    a.set_defaults(func=cmd_add)

    l = sub.add_parser("ls", parents=[common], help="list tasks")
    l.add_argument("--status", choices=STATUSES)
    l.add_argument("--assignee")
    l.add_argument("--label")
    l.set_defaults(func=cmd_ls)

    sub.add_parser("board", parents=[common], help="column view of the board").set_defaults(func=cmd_board)

    s = sub.add_parser("show", parents=[common], help="task detail + history")
    s.add_argument("id")
    s.set_defaults(func=cmd_show)

    m = sub.add_parser("move", parents=[common], help="set status directly")
    m.add_argument("id")
    m.add_argument("status", choices=STATUSES)
    m.set_defaults(func=cmd_move)

    c = sub.add_parser("claim", parents=[common], help="claim a ready task (atomic)")
    c.add_argument("id", nargs="?", help="task id; omit with --any to claim best ready task")
    c.add_argument("--any", action="store_true", help="claim highest-priority ready task")
    c.add_argument("--assignee", help="with --any: only tasks assigned to this agent")
    c.add_argument("--ttl", type=int, help=f"claim TTL in seconds (default {DEFAULT_CLAIM_TTL})")
    c.set_defaults(func=cmd_claim)

    r = sub.add_parser("release", parents=[common], help="release your claim back to ready")
    r.add_argument("id")
    r.add_argument("--force", action="store_true", help="release someone else's claim")
    r.set_defaults(func=cmd_release)

    rc = sub.add_parser("reclaim", parents=[common], help="release expired claims back to ready")
    rc.add_argument("id", nargs="?", help="specific task to reclaim")
    rc.add_argument("--force", action="store_true", help="reclaim even if not expired")
    rc.set_defaults(func=cmd_reclaim)

    cp = sub.add_parser("complete", parents=[common], help="mark done; promotes children whose parents are all done")
    cp.add_argument("id")
    cp.add_argument("--summary", default="")
    cp.set_defaults(func=cmd_complete)

    b = sub.add_parser("block", parents=[common], help="mark blocked with a reason")
    b.add_argument("id")
    b.add_argument("--reason", default="")
    b.set_defaults(func=cmd_block)

    u = sub.add_parser("unblock", parents=[common], help="move blocked task back to ready")
    u.add_argument("id")
    u.set_defaults(func=cmd_unblock)

    asg = sub.add_parser("assign", parents=[common], help="set assignee")
    asg.add_argument("id")
    asg.add_argument("assignee")
    asg.set_defaults(func=cmd_assign)

    e = sub.add_parser("edit", parents=[common], help="edit title/body/priority/labels")
    e.add_argument("id")
    e.add_argument("--title")
    e.add_argument("--body")
    e.add_argument("--priority", type=int)
    e.add_argument("--label", action="append")
    e.set_defaults(func=cmd_edit)

    ln = sub.add_parser("link", parents=[common], help="link parent -> child (child waits for parent)")
    ln.add_argument("parent")
    ln.add_argument("child")
    ln.set_defaults(func=cmd_link)

    ul = sub.add_parser("unlink", parents=[common], help="remove a parent -> child link")
    ul.add_argument("parent")
    ul.add_argument("child")
    ul.set_defaults(func=cmd_unlink)

    cm = sub.add_parser("comment", parents=[common], help="add a note to a task's history")
    cm.add_argument("id")
    cm.add_argument("text")
    cm.set_defaults(func=cmd_comment)

    rm = sub.add_parser("rm", parents=[common], help="archive a task, a whole status ('rm done'), or everything ('rm --all')")
    rm.add_argument("id", nargs="?", help="task id, or a status name (todo/ready/doing/done/blocked) to archive all cards in it")
    rm.add_argument("--all", action="store_true", help="archive all non-archived cards")
    rm.set_defaults(func=cmd_rm)

    pr = sub.add_parser("prune", parents=[common], help="permanently delete archived cards, their links and their events")
    pr.add_argument("--dry-run", action="store_true", help="show what would be deleted without deleting")
    pr.set_defaults(func=cmd_prune)

    ev = sub.add_parser("events", parents=[common], help="dump the change feed")
    ev.add_argument("--task", help="only events for this task")
    ev.add_argument("--limit", type=int, default=50)
    ev.set_defaults(func=cmd_events)

    w = sub.add_parser("watch", parents=[common], help="stream the change feed live (Ctrl-C to stop)")
    w.add_argument("--since", type=int, help="event id to start after (default: latest)")
    w.add_argument("--interval", type=float, default=0.2, help="poll interval seconds (default 0.2)")
    w.set_defaults(func=cmd_watch)

    d = sub.add_parser("dash", aliases=["dashboard", "live"], parents=[common],
                       help="live-updating board view in the terminal (Ctrl-C to stop)")
    d.add_argument("--interval", type=float, default=0.5, help="refresh seconds (default 0.5)")
    d.add_argument("--once", action="store_true", help="render one snapshot and exit (default when piped)")
    d.add_argument("--follow", action="store_true", help="keep streaming frames even when not a TTY")
    d.add_argument("--feed", type=int, default=8, help="feed lines to show at the bottom (default 8)")
    d.set_defaults(func=cmd_dash)

    sv = sub.add_parser("serve", parents=[common],
                        help="run the leader server: other PCs connect via KANBAN_URL (leader-follower mode)")
    sv.add_argument("--host", default="127.0.0.1", help="bind address (default 127.0.0.1; use 0.0.0.0 for LAN)")
    sv.add_argument("--port", type=int, default=8765, help="port (default 8765)")
    sv.set_defaults(func=cmd_serve)  # --passkey comes from the common parser

    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    url = getattr(args, "url", None) or os.environ.get("KANBAN_URL")
    if url and args.cmd != "serve":
        if args.cmd == "watch":
            remote_watch(args, url)
            return
        if args.cmd in ("dash", "dashboard", "live"):
            remote_dash(args, url)
            return
        remote_post(url, args)
        return
    try:
        args.func(args)
    except sqlite3.OperationalError as e:
        die(f"database busy or locked: {e}", 1)


if __name__ == "__main__":
    main()
