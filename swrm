        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    t = get_task(con, args.id)
    con.close()
    out(args, f"{t['id']} assigned to {args.assignee or '(none)'}", t)


def cmd_edit(args):
