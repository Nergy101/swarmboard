def cmd_link(args):
    con = connect(resolve_db(args))
    actor = resolve_actor(args)
    con.execute("BEGIN IMMEDIATE")
    try:
        get_task(con, args.parent)
        child = get_task(con, args.child)
        if args.parent == args.child:
            con.execute("ROLLBACK")
            con.close()
            die("cannot link a task to itself", 2)
        con.execute("INSERT OR IGNORE INTO links (parent_id, child_id) VALUES (?,?)", (args.parent, args.child))
        emit(con, actor, "linked", args.child, parent=args.parent)
        # A child with unfinished parents must not be runnable.
        if child["status"] in ("ready", "doing") and not all_parents_done(con, args.child):
            con.execute("UPDATE tasks SET status='todo', updated_at=? WHERE id=?", (now_iso(), args.child))
            emit(con, actor, "demoted", args.child, reason=f"parent {args.parent} not done")
        con.execute("COMMIT")
    except Exception:
        try:
            con.execute("ROLLBACK")
        except sqlite3.Error:
            pass
        raise
    con.close()
    out(args, f"linked {args.parent} -> {args.child}", {"parent": args.parent, "child": args.child})


def cmd_unlink(args):
    con = connect(resolve_db(args))
    actor = resolve_actor(args)
    con.execute("BEGIN IMMEDIATE")
    try:
        cur = con.execute("DELETE FROM links WHERE parent_id=? AND child_id=?", (args.parent, args.child))
        if cur.rowcount == 0:
            con.execute("ROLLBACK")
            con.close()
            die(f"no link {args.parent} -> {args.child}", 1)
        emit(con, actor, "unlinked", args.child, parent=args.parent)
        recheck_promotion(con, actor, args.child)
        con.execute("COMMIT")
    except Exception:
        try:
            con.execute("ROLLBACK")
        except sqlite3.Error:
            pass
        raise
    con.close()
    out(args, f"unlinked {args.parent} -> {args.child}", {"parent": args.parent, "child": args.child})


