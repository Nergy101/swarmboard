STATUSES = ["todo", "ready", "doing", "done", "blocked", "archived"]
ACTIVE_STATUSES = ["todo", "ready", "doing", "blocked"]
DEFAULT_CLAIM_TTL = int(os.environ.get("KANBAN_CLAIM_TTL", "900"))  # seconds

# Per-label colors (see `swrm label color <name> <color>`).
LABEL_COLORS = {
    "red": "\033[31m",
    "green": "\033[32m",
    "yellow": "\033[33m",
    "blue": "\033[34m",
    "magenta": "\033[35m",
    "cyan": "\033[36m",
    "white": "\033[37m",
    "default": "",
}

# ------------------------------------------------------------------ connectors
# Default board -> Linear status mapping (override per connector with
# `swrm connector add linear --map <boardstatus>=<linear state>`).
DEFAULT_STATUS_MAP = {
    "todo": "Todo",
    "ready": "Todo",
    "doing": "In Progress",
    "blocked": "In Review",
    "done": "Done",
}
CONNECTOR_TYPES = ["linear"]
CONNECTOR_ACTOR_PREFIX = "connector:"
DEFAULT_LINEAR_API = "https://api.linear.app/graphql"
EPOCH_ISO = "1970-01-01T00:00:00.000Z"
# Events that trigger a push (status changes use the status name as action).
PUSH_ACTIONS = {"created", "edited", "assigned"} | {s for s in ACTIVE_STATUSES} | {"done"}


SCHEMA = """
CREATE TABLE IF NOT EXISTS tasks (
    id               TEXT PRIMARY KEY,
    title            TEXT NOT NULL,
    body             TEXT NOT NULL DEFAULT '',
    status           TEXT NOT NULL DEFAULT 'todo',
    priority         INTEGER NOT NULL DEFAULT 0,
    assignee         TEXT NOT NULL DEFAULT '',
    labels           TEXT NOT NULL DEFAULT '',
    result           TEXT NOT NULL DEFAULT '',
    created_at       TEXT NOT NULL,
    updated_at       TEXT NOT NULL,
    claimed_by       TEXT NOT NULL DEFAULT '',
    claimed_at       TEXT NOT NULL DEFAULT '',
    claim_expires_at TEXT NOT NULL DEFAULT '',
    external_ref     TEXT NOT NULL DEFAULT ''
);
CREATE TABLE IF NOT EXISTS links (
    parent_id TEXT NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
    child_id  TEXT NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
    PRIMARY KEY (parent_id, child_id)
);
CREATE TABLE IF NOT EXISTS events (
    id      INTEGER PRIMARY KEY AUTOINCREMENT,
    ts      TEXT NOT NULL,
    actor   TEXT NOT NULL,
    action  TEXT NOT NULL,
    task_id TEXT,
    details TEXT NOT NULL DEFAULT '{}'
);
CREATE TABLE IF NOT EXISTS label_colors (
    name  TEXT PRIMARY KEY,
    color TEXT NOT NULL DEFAULT ''
);
CREATE TABLE IF NOT EXISTS connector_state (
    connector TEXT NOT NULL,
    key       TEXT NOT NULL,
    value     TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (connector, key)
);
CREATE INDEX IF NOT EXISTS idx_tasks_status   ON tasks(status);
CREATE INDEX IF NOT EXISTS idx_tasks_assignee ON tasks(assignee);
CREATE INDEX IF NOT EXISTS idx_links_child    ON links(child_id);
CREATE INDEX IF NOT EXISTS idx_events_id      ON events(id);
"""


# ---------------------------------------------------------------- helpers

def now_iso():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def resolve_db(args):
    """Resolution order: --db > -b/--board > $KANBAN_DB > ./.kanban/kanban.db (if it
    exists) > the active board from the registry; final fallback is the cwd default."""
    if getattr(args, "db", None):
        return os.path.abspath(args.db)
    board = getattr(args, "board", None)
    if board:
        reg = load_registry()
        if board not in reg["boards"]:
            die(f"unknown board: {board}; add it with `swrm boards add {board} <path>`", 2)
        return os.path.abspath(reg["boards"][board])
    envdb = os.environ.get("KANBAN_DB")
    if envdb:
        return os.path.abspath(envdb)
    cwd_default = os.path.abspath(os.path.join(".kanban", "kanban.db"))
    if os.path.exists(cwd_default):
        return cwd_default
    reg = load_registry()
    if reg["active"]:
        return os.path.abspath(reg["boards"][reg["active"]])
    return cwd_default


def board_label(args):
    """Human-friendly board identity for titles: explicit flag, else the same
    rule as resolve_db (name for registry boards, path otherwise)."""
    board = getattr(args, "board", None)
    if board:
        return board
    if getattr(args, "db", None) or os.environ.get("KANBAN_DB"):
        return resolve_db(args)
    reg = load_registry()
    cwd_default = os.path.abspath(os.path.join(".kanban", "kanban.db"))
    if os.path.exists(cwd_default):
        return cwd_default
    if reg["active"]:
        return reg["active"]
    return cwd_default


def resolve_actor(args):
    return args.actor or os.environ.get("KANBAN_ACTOR") or os.environ.get("USER") or "unknown"


def swrm_home():
    """Directory holding the board registry (override with $SWRM_HOME, mainly for tests)."""
    return os.environ.get("SWRM_HOME") or os.path.expanduser("~/.swarmboard")


def registry_path():
    return os.path.join(swrm_home(), "boards.json")


def load_registry():
    try:
        with open(registry_path()) as f:
            reg = json.load(f)
        if not isinstance(reg, dict) or not isinstance(reg.get("boards"), dict):
            raise ValueError("bad registry")
    except Exception:
        return {"active": None, "boards": {}}
    reg.setdefault("active", None)
    reg.setdefault("boards", {})
    return reg


def save_registry(reg):
    d = swrm_home()
    os.makedirs(d, exist_ok=True)
    with open(registry_path(), "w") as f:
        json.dump(reg, f, indent=2)


# ------------------------------------------------------------- connectors (NER-331)


class ConnectorError(Exception):
    pass


def connectors_paths(args):
    """(config, secrets) paths, both next to the resolved board database.
    Tokens live in connectors.secrets.json (mode 600), never in the board db."""
    d = os.path.dirname(os.path.abspath(resolve_db(args)))
    return (os.path.join(d, "connectors.json"),
            os.path.join(d, "connectors.secrets.json"))


def load_connectors(args):
    path, _ = connectors_paths(args)
    try:
        with open(path) as f:
            doc = json.load(f)
        if not isinstance(doc, dict) or not isinstance(doc.get("connectors"), dict):
            raise ValueError("bad connectors config")
        return doc
    except FileNotFoundError:
        return {"connectors": {}}
    except (OSError, ValueError, json.JSONDecodeError) as e:
        die(f"cannot read {path}: {e}", 1)


def save_connectors(args, doc):
    path, _ = connectors_paths(args)
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    with open(path, "w") as f:
        json.dump(doc, f, indent=2)
    try:
        os.chmod(path, 0o644)
    except OSError:
        pass


def load_secrets(args):
    _, path = connectors_paths(args)
    try:
        with open(path) as f:
            doc = json.load(f)
        return doc if isinstance(doc, dict) else {}
    except (FileNotFoundError, OSError, ValueError, json.JSONDecodeError):
        return {}


def save_secret(args, name, token):
    _, path = connectors_paths(args)
    secrets = load_secrets(args)
    secrets[name] = {"token": token}
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(secrets, f, indent=2)
    os.chmod(path, 0o600)


def resolve_connector_token(args, name, ctype):
    env = {"linear": "SWRM_LINEAR_TOKEN"}.get(ctype)
    sec = load_secrets(args).get(name, {})
    token = sec.get("token") or (os.environ.get(env) if env else None)
    if not token:
        hint = f" or set ${env}" if env else ""
        die(f"connector '{name}' has no token; run `swrm connector auth {name} --token <token>`{hint}", 2)
    return token


def get_state(con, connector, key, default=None):
    r = con.execute("SELECT value FROM connector_state WHERE connector=? AND key=?",
                    (connector, key)).fetchone()
    return r["value"] if r else default


def set_state(con, connector, key, value):
    con.execute("INSERT INTO connector_state (connector, key, value) VALUES (?,?,?) "
                "ON CONFLICT(connector, key) DO UPDATE SET value=excluded.value",
                (connector, key, str(value)))


def _linear_gql(cfg, token, query, variables=None, _attempt=0):
    """One Linear GraphQL call (stdlib urllib); exponential backoff on
    429/5xx/network errors, honoring Retry-After."""
    api = cfg.get("api_base") or DEFAULT_LINEAR_API
    payload = json.dumps({"query": query, "variables": variables or {}}).encode()
    req = urllib.request.Request(api, data=payload, method="POST")
    req.add_header("Authorization", token)
    req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            body = json.loads(r.read().decode() or "{}")
    except urllib.error.HTTPError as e:
        if e.code in (429, 500, 502, 503) and _attempt < 3:
            try:
                wait = float(e.headers.get("Retry-After"))
            except (TypeError, ValueError):
                wait = 0.5 * (2 ** _attempt)
            time.sleep(min(wait, 30.0))
            return _linear_gql(cfg, token, query, variables, _attempt + 1)
        raise ConnectorError(f"Linear API HTTP {e.code}: {e.read().decode(errors='replace')[:300]}") from e
    except urllib.error.URLError as e:
        if _attempt < 3:
            time.sleep(min(0.5 * (2 ** _attempt), 30.0))
            return _linear_gql(cfg, token, query, variables, _attempt + 1)
        raise ConnectorError(f"Linear API unreachable: {e}") from e
    if body.get("errors"):
        msgs = "; ".join(str(e.get("message")) for e in body["errors"])
        raise ConnectorError(f"Linear API error: {msgs[:400]}")
    return body.get("data") or {}


def _linear_team_id(cfg, token):
    value = cfg.get("team")
    if not value:
        return None
    data = _linear_gql(cfg, token, "query { teams(first: 100) { nodes { id key name } } }")
    nodes = ((data.get("teams") or {}).get("nodes")) or []
    for n in nodes:
        if value in (n.get("id"), n.get("key"), n.get("name")):
            return n["id"]
    known = ", ".join(sorted(str(n.get("key")) for n in nodes))
    raise ConnectorError(f"no Linear team matches {value!r} (known teams: {known})")


def _linear_project_id(cfg, token):
    value = cfg.get("project")
    if not value:
        return None
    data = _linear_gql(cfg, token, "query { projects(first: 100) { nodes { id name } } }")
    nodes = ((data.get("projects") or {}).get("nodes")) or []
    for n in nodes:
        if value in (n.get("id"), n.get("name")):
            return n["id"]
    raise ConnectorError(f"no Linear project matches {value!r}")


def _linear_states(cfg, token, team_id):
    if not team_id:
        return {}
    data = _linear_gql(cfg, token,
                      "query($id: String!) { team(id: $id) { states { nodes { id name } } } }",
                      {"id": team_id})
    nodes = (((data.get("team") or {}).get("states")) or {}).get("nodes") or []
    return {n["name"]: n["id"] for n in nodes}


def _reverse_status_map(status_map):
    rev = {}
    for local, external in status_map.items():
        rev.setdefault(external, local)
    return rev


def _linear_push_task(con, name, cfg, token, task, states, team_id, project_id):
    """Mirror the CURRENT task state to Linear (idempotent). Creates the issue
    when the task has no external_ref yet."""
    ref = task["external_ref"]
    if ref:
        inp = {"title": task["title"], "description": task["body"]}
        state_id = states.get(cfg["status_map"].get(task["status"]))
        if state_id:
            inp["stateId"] = state_id
        data = _linear_gql(cfg, token,
                           "mutation($id: String!, $input: IssueUpdateInput!) "
                           "{ issueUpdate(id: $id, input: $input) { success issue { id } } }",
                           {"id": ref, "input": inp})
        ok = (data.get("issueUpdate") or {}).get("success")
        if not ok:
            raise ConnectorError(f"issueUpdate failed for {ref}")
        return "updated"
    if not team_id:
        raise ConnectorError("task without external_ref: creating Linear issues needs a team "
                             "(`swrm connector add ... --key team=<key|naam|id>`)")
    inp = {"teamId": team_id, "title": task["title"], "description": task["body"]}
    if project_id:
        inp["projectId"] = project_id
    data = _linear_gql(cfg, token,
                       "mutation($input: IssueCreateInput!) "
                       "{ issueCreate(input: $input) { success issue { id identifier } } }",
                       {"input": inp})
    payload = data.get("issueCreate") or {}
    issue = payload.get("issue") or {}
    if not payload.get("success") or not issue.get("id"):
        raise ConnectorError("issueCreate failed")
    con.execute("UPDATE tasks SET external_ref=? WHERE id=?", (issue["id"], task["id"]))
    emit(con, CONNECTOR_ACTOR_PREFIX + name, "external-linked", task["id"],
         ref=issue["id"], identifier=issue.get("identifier", ""))
    return "created"


def _linear_pull(con, name, cfg, token, states, team_id, project_id, full=False):
    """Apply Linear issues changed since the pull cursor to the board.
    Last-write-wins with a per-issue marker so one change syncs exactly once."""
    cursor = get_state(con, name, "pull_cursor") or ""
    if full or not cursor:
        cursor = EPOCH_ISO
    filt = {"updatedAt": {"gte": cursor}}
    if team_id:
        filt["team"] = {"id": {"eq": team_id}}
    if project_id:
        filt["project"] = {"id": {"eq": project_id}}
    rev = _reverse_status_map(cfg["status_map"])
    pull_new = str(cfg.get("pull_new", "false")).lower() in ("1", "true", "yes", "on")
    actor = CONNECTOR_ACTOR_PREFIX + name
    created = updated = skipped = 0
    newest = cursor
    after = None
    while True:
        data = _linear_gql(cfg, token,
                           "query($after: String, $filter: IssueFilter!) "
                           "{ issues(first: 100, after: $after, filter: $filter) "
                           "{ nodes { id identifier title description updatedAt state { name } } "
                           "pageInfo { hasNextPage endCursor } } }",
                           {"after": after, "filter": filt})
        conn_issues = ((data.get("issues") or {}).get("nodes")) or []
        for issue in conn_issues:
            i_id = issue["id"]
            i_updated = issue.get("updatedAt") or ""
            if i_updated > newest:
                newest = i_updated
            marker = get_state(con, name, f"issue_ts:{i_id}")
            if marker == i_updated:
                continue  # already applied; nothing to do
            state_name = (issue.get("state") or {}).get("name")
            local_status = rev.get(state_name or "")
            r = con.execute("SELECT * FROM tasks WHERE external_ref=?", (i_id,)).fetchone()
            if r is None:
                if not pull_new or local_status is None:
                    skipped += 1
                    continue
                tid = new_id()
                con.execute(
                    "INSERT INTO tasks (id, title, body, status, priority, assignee, labels,"
                    " result, created_at, updated_at, claimed_by, claimed_at,"
                    " claim_expires_at, external_ref) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                    (tid, issue.get("title") or "(titelloos)", issue.get("description") or "",
                     local_status, 0, "", "", "", now_iso(), now_iso(), "", "", "", i_id))
                emit(con, actor, "created", tid, source=name, issue=issue.get("identifier"),
                     status=local_status)
                created += 1
            else:
                if local_status is None:
                    local_status = r["status"]  # unmapped Linear state: leave the board alone
                title = issue.get("title") or ""
                body = issue.get("description") or ""
                if r["title"] == title and r["body"] == body and r["status"] == local_status:
                    set_state(con, name, f"issue_ts:{i_id}", i_updated)
                    continue  # no visible change; only advance the marker
                con.execute("UPDATE tasks SET title=?, body=?, status=?, updated_at=? WHERE id=?",
                            (title, body, local_status, now_iso(), r["id"]))
                if local_status != r["status"]:
                    emit(con, actor, local_status, r["id"], prev=r["status"], source=name,
                         issue=issue.get("identifier"), reason="linear sync")
                else:
                    emit(con, actor, "synced", r["id"], source=name, issue=issue.get("identifier"),
                         title=title)
                updated += 1
            set_state(con, name, f"issue_ts:{i_id}", i_updated)
        page = (data.get("issues") or {}).get("pageInfo") or {}
        if page.get("hasNextPage") and page.get("endCursor"):
            after = page["endCursor"]
        else:
            break
    set_state(con, name, "pull_cursor", newest)
    return {"created": created, "updated": updated, "skipped": skipped}


def _connector_full_reset(con, name):
    """--full: forget cursors and per-issue markers so the next cycle
    resyncs everything from scratch."""
    con.execute("DELETE FROM connector_state WHERE connector=?", (name,))


def _sync_connector(con, args, name, conn, token, full=False):
    """One sync cycle: push board events -> Linear, then pull Linear -> board.
    Cursors in connector_state make every cycle resumable and idempotent."""
    cfg = dict(conn.get("config") or {})
    cfg["status_map"] = dict(conn.get("status_map") or DEFAULT_STATUS_MAP)
    if full:
        _connector_full_reset(con, name)
    team_id = _linear_team_id(cfg, token)
    project_id = _linear_project_id(cfg, token)
    states = _linear_states(cfg, token, team_id) if team_id else {}
    summary = {"connector": name, "pushed": 0, "created_issues": 0, "updated_issues": 0,
               "pulled_created": 0, "pulled_updated": 0, "pull_skipped": 0}

    cursor = int(get_state(con, name, "push_cursor", "0") or 0)
    rows = con.execute("SELECT id, actor, action, task_id FROM events WHERE id > ? ORDER BY id",
                       (cursor,)).fetchall()
    max_id = rows[-1]["id"] if rows else cursor
    # push candidates: tasks whose relevant events changed since the cursor
    candidates = {}
    for r in rows:
        if (r["task_id"] and not r["actor"].startswith(CONNECTOR_ACTOR_PREFIX)
                and r["action"] in PUSH_ACTIONS):
            candidates.setdefault(r["task_id"], r["id"])
    for tid in sorted(candidates, key=lambda t: candidates[t]):
        t = con.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone()
        if t is None or t["status"] == "archived":
            continue
        try:
            result = _linear_push_task(con, name, cfg, token, dict(t), states, team_id, project_id)
        except ConnectorError:
            # resumable: leave the cursor at the event that failed
            set_state(con, name, "push_cursor", str(candidates[tid] - 1))
            raise
        summary["pushed"] += 1
        summary["created_issues" if result == "created" else "updated_issues"] += 1
    if rows:
        set_state(con, name, "push_cursor", str(max_id))

    pull = _linear_pull(con, name, cfg, token, states, team_id, project_id, full=full)
    summary["pulled_created"] = pull["created"]
    summary["pulled_updated"] = pull["updated"]
    summary["pull_skipped"] = pull["skipped"]
    summary["synced_at"] = now_iso()
    set_state(con, name, "last_sync_at", now_iso())
    set_state(con, name, "last_pushed", summary["pushed"])
    set_state(con, name, "last_pulled", pull["created"] + pull["updated"])
    set_state(con, name, "last_error", "")
    return summary



def connect(path, create=True):
    if create:
        d = os.path.dirname(path)
        if d:
            os.makedirs(d, exist_ok=True)
    con = sqlite3.connect(path, timeout=15, isolation_level=None)
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("PRAGMA busy_timeout=15000")
    con.execute("PRAGMA foreign_keys=ON")
    con.execute("PRAGMA synchronous=NORMAL")
    if create:
        con.executescript(SCHEMA)
        # migration for boards created before connectors existed (NER-331)
        cols = {r[1] for r in con.execute("PRAGMA table_info(tasks)")}
        if "external_ref" not in cols:
            con.execute("ALTER TABLE tasks ADD COLUMN external_ref TEXT NOT NULL DEFAULT ''")
    return con


def emit(con, actor, action, task_id=None, **details):
    con.execute(
        "INSERT INTO events (ts, actor, action, task_id, details) VALUES (?,?,?,?,?)",
        (now_iso(), actor, action, task_id, json.dumps(details, ensure_ascii=False)),
    )


def new_id():
    return "t_" + uuid.uuid4().hex[:8]


def row_to_task(r):
    d = dict(r)
    d["labels"] = [x for x in d["labels"].split(",") if x]
    return d


def get_task(con, task_id):
    r = con.execute("SELECT * FROM tasks WHERE id=?", (task_id,)).fetchone()
    if not r:
        die(f"no such task: {task_id}", 1)
    return row_to_task(r)


def parent_statuses(con, child_id):
    rows = con.execute(
        "SELECT p.id, p.status FROM links l JOIN tasks p ON p.id = l.parent_id WHERE l.child_id=?",
        (child_id,),
    ).fetchall()
    return [(r["id"], r["status"]) for r in rows]


def all_parents_done(con, child_id):
    return all(s == "done" for _, s in parent_statuses(con, child_id))


def promote_children(con, actor, parent_id):
    """Promote todo children of parent_id whose parents are all done."""
    kids = con.execute("SELECT child_id FROM links WHERE parent_id=?", (parent_id,)).fetchall()
    for k in kids:
        cid = k["child_id"]
        t = con.execute("SELECT status FROM tasks WHERE id=?", (cid,)).fetchone()
        if t and t["status"] == "todo" and all_parents_done(con, cid):
            con.execute(
                "UPDATE tasks SET status='ready', updated_at=? WHERE id=?", (now_iso(), cid)
            )
            emit(con, actor, "promoted", cid, reason=f"all parents done (incl. {parent_id})")


def recheck_promotion(con, actor, child_id):
    t = con.execute("SELECT status FROM tasks WHERE id=?", (child_id,)).fetchone()
    if t and t["status"] == "todo" and all_parents_done(con, child_id):
        con.execute("UPDATE tasks SET status='ready', updated_at=? WHERE id=?", (now_iso(), child_id))
        emit(con, actor, "promoted", child_id, reason="all parents done")


def touch(con, task_id):
    con.execute("UPDATE tasks SET updated_at=? WHERE id=?", (now_iso(), task_id))


def get_label_colors(con):
    """Per-board label colors as {label: ansi_code_or_empty}."""
    try:
        rows = con.execute("SELECT name, color FROM label_colors").fetchall()
    except sqlite3.OperationalError:
        return {}
    return {r["name"]: LABEL_COLORS.get(r["color"], "") for r in rows}


def colorize_label(label, colors=None, raw=False):
    """A '#label' token, ANSI-colored when a color is set (unless NO_COLOR)."""
    code = (colors or {}).get(label, "")
    if code and not raw and not os.environ.get("NO_COLOR") and sys.stdout.isatty():
        return f"{code}#{label}{RESET}"
    return f"#{label}"


def die(msg, code=1):
    print(f"swrm: error: {msg}", file=sys.stderr)
    sys.exit(code)


def out(args, human, data):
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        print(human)


# ---------------------------------------------------------------- commands

def cmd_init(args):
    path = resolve_db(args)
    con = connect(path)
    con.close()
    out(args, f"initialized board at {path}", {"db": path})


def cmd_boards(args):
    """`swrm boards` lists the registry; add/rename/rm manage it (databases are
    never created or deleted by the registry, only referenced)."""
    reg = load_registry()
    action = args.action
    if action in (None, "ls", "list"):
        rows = [{"name": n, "path": p, "active": n == reg["active"]}
                for n, p in sorted(reg["boards"].items())]
        if args.json:
            out(args, "", {"active": reg["active"], "boards": rows})
            return
        if not rows:
            print("(no registered boards; add one with `swrm boards add <naam> <pad>`)")
            return
        for r in rows:
            mark = "->" if r["active"] else "  "
            print(f"{mark} {r['name']:<24} {r['path']}")
        return
    if action == "add":
        if not args.name or not args.path_or_new:
            die("usage: swrm boards add <naam> <pad/naar/board.db>", 2)
        if args.name in reg["boards"]:
            die(f"board name taken: {args.name}", 1)
        path = os.path.abspath(args.path_or_new)
        reg["boards"][args.name] = path
        save_registry(reg)
        out(args, f"registered board '{args.name}' -> {path}",
            {"name": args.name, "path": path})
        return
    if action == "rename":
        if not args.name or not args.path_or_new:
            die("usage: swrm boards rename <oud> <nieuw>", 2)
        if args.name not in reg["boards"]:
            die(f"unknown board: {args.name}", 1)
        if args.path_or_new in reg["boards"]:
            die(f"board name taken: {args.path_or_new}", 1)
        reg["boards"][args.path_or_new] = reg["boards"].pop(args.name)
        if reg["active"] == args.name:
            reg["active"] = args.path_or_new
        save_registry(reg)
        out(args, f"renamed board '{args.name}' -> '{args.path_or_new}'",
            {"name": args.path_or_new, "previous": args.name,
             "path": reg["boards"][args.path_or_new]})
        return
    if action == "rm":
        if not args.name:
            die("usage: swrm boards rm <naam>", 2)
        if args.name not in reg["boards"]:
            die(f"unknown board: {args.name}", 1)
        del reg["boards"][args.name]
        if reg["active"] == args.name:
            reg["active"] = None
        save_registry(reg)
        out(args, f"unregistered board '{args.name}' (database left untouched)",
            {"removed": args.name})


def cmd_switch(args):
    reg = load_registry()
    if args.name not in reg["boards"]:
        known = ", ".join(sorted(reg["boards"])) or "(none)"
        die(f"unknown board: {args.name}; known boards: {known}", 1)
    reg["active"] = args.name
    save_registry(reg)
    path = os.path.abspath(reg["boards"][args.name])
    out(args, f"switched to board '{args.name}' ({path})",
        {"active": args.name, "path": path})


def cmd_connector(args):
    """`swrm connector add|ls|rm|auth|sync|pause|resume|status` (NER-331)."""
    a = args.connector_cmd
    doc = load_connectors(args)
    conns = doc["connectors"]

    if a == "ls":
        rows = [{"name": n, "type": c.get("type"), "paused": bool(c.get("paused")),
                 "team": (c.get("config") or {}).get("team"),
                 "project": (c.get("config") or {}).get("project")}
                for n, c in sorted(conns.items())]
        if args.json:
            out(args, "", {"connectors": rows})
            return
        if not rows:
            print("(no connectors; add one with `swrm connector add linear --key team=<key>`)")
            return
        for r in rows:
            state = "paused" if r["paused"] else "active"
            print(f"{r['name']:<18} {str(r['type']):<10} {state:<8} "
                  f"team={r['team'] or '-':<20} project={r['project'] or '-'}")
        return

    if a == "add":
        ctype = args.type
        name = args.name or ctype
        if name in conns:
            die(f"connector name taken: {name}", 1)
        config, status_map = {}, dict(DEFAULT_STATUS_MAP)
        for kv in args.key or []:
            if "=" not in kv:
                die(f"--key expects <k>=<v>, got {kv!r}", 2)
            k, v = kv.split("=", 1)
            if k not in ("team", "project", "pull_new", "api_base"):
                die(f"unknown key {k!r} (valid: team, project, pull_new, api_base)", 2)
            config[k] = v
        for kv in args.map or []:
            if "=" not in kv:
                die(f"--map expects <boardstatus>=<linearstatus>, got {kv!r}", 2)
            k, v = kv.split("=", 1)
            if k not in ("todo", "ready", "doing", "blocked", "done"):
                die(f"--map left side must be one of todo/ready/doing/blocked/done, got {k!r}", 2)
            status_map[k] = v
        conns[name] = {"type": ctype, "paused": False, "config": config,
                       "status_map": status_map}
        save_connectors(args, doc)
        out(args, f"added {ctype} connector '{name}'",
            {"name": name, "type": ctype, "config": config, "status_map": status_map})
        return

    if a == "rm":
        if args.name not in conns:
            die(f"unknown connector: {args.name}", 1)
        del conns[args.name]
        save_connectors(args, doc)
        con = connect(resolve_db(args))
        con.execute("DELETE FROM connector_state WHERE connector=?", (args.name,))
        con.close()
        out(args, f"removed connector '{args.name}' (sync state cleared)", {"removed": args.name})
        return

    if a == "auth":
        if args.name not in conns:
            die(f"unknown connector: {args.name}", 1)
        token = args.token
        if not token and args.token_file:
            try:
                with open(os.path.expanduser(args.token_file)) as f:
                    token = f.read().strip()
            except OSError as e:
                die(f"cannot read token file: {e}", 1)
        if not token:
            die("provide --token <token> or --token-file <pad>", 2)
        save_secret(args, args.name, token)
        out(args, f"stored token for connector '{args.name}' in connectors.secrets.json (mode 600)",
            {"connector": args.name})
        return

    if a in ("pause", "resume"):
        if args.name not in conns:
            die(f"unknown connector: {args.name}", 1)
        conns[args.name]["paused"] = (a == "pause")
        save_connectors(args, doc)
        out(args, f"connector '{args.name}' {a}d", {"connector": args.name, "paused": a == "pause"})
        return

    if a == "sync":
        if args.name:
            if args.name not in conns:
                die(f"unknown connector: {args.name}", 1)
            names = [args.name]
        else:
            names = sorted(n for n, c in conns.items() if not c.get("paused"))
            if not names:
                die("no unpaused connectors to sync", 1)
        con = connect(resolve_db(args))
        results = []
        try:
            for n in names:
                c = conns[n]
                if c.get("paused") and not args.name:
                    continue
                if c.get("paused") and args.name:
                    con.close()
                    die(f"connector '{n}' is paused; resume it first (`swrm connector resume {n}`)", 1)
                token = resolve_connector_token(args, n, c.get("type"))
                try:
                    s = _sync_connector(con, args, n, c, token, full=args.full)
                except ConnectorError as e:
                    set_state(con, n, "last_error", str(e))
                    results.append({"connector": n, "error": str(e)})
                    continue
                results.append(s)
        finally:
            con.close()
        errs = [r for r in results if r.get("error")]
        if args.json:
            out(args, "", {"synced": results})
        else:
            for r in results:
                if r.get("error"):
                    print(f"{r['connector']}: SYNC FAILED: {r['error']}")
                else:
                    print(f"{r['connector']}: pushed {r['pushed']} (created {r['created_issues']}, "
                          f"updated {r['updated_issues']}), pulled {r['pulled_created']} created / "
                          f"{r['pulled_updated']} updated / {r['pull_skipped']} skipped")
        if errs:
            sys.exit(1)
        return

    if a == "status":
        con = connect(resolve_db(args))
        names = [args.name] if args.name else sorted(conns)
        if args.name and args.name not in conns:
            die(f"unknown connector: {args.name}", 1)
        data = []
        for n in names:
            c = conns[n]
            data.append({
                "name": n, "type": c.get("type"), "paused": bool(c.get("paused")),
                "team": (c.get("config") or {}).get("team"),
                "project": (c.get("config") or {}).get("project"),
                "status_map": c.get("status_map") or DEFAULT_STATUS_MAP,
                "last_sync": get_state(con, n, "last_sync_at") or "",
                "last_pushed": get_state(con, n, "last_pushed") or "",
                "last_pulled": get_state(con, n, "last_pulled") or "",
                "last_error": get_state(con, n, "last_error") or "",
                "push_cursor": get_state(con, n, "push_cursor") or "",
                "pull_cursor": get_state(con, n, "pull_cursor") or "",
            })
        con.close()
        if args.json:
            out(args, "", {"connectors": data})
            return
        for d in data:
            state = "paused" if d["paused"] else "active"
            print(f"{d['name']:<18} {str(d['type']):<10} {state:<8} last sync: {d['last_sync'] or 'never'}")
            if d["last_error"]:
                print(f"    last error: {d['last_error']}")
            print(f"    cursors: push={d['push_cursor'] or '-'} pull={d['pull_cursor'] or '-'}")
        return


def cmd_add(args):
    con = connect(resolve_db(args))
    actor = resolve_actor(args)
    parents = args.parent or []
    con.execute("BEGIN IMMEDIATE")
    try:
        for p in parents:
            get_task(con, p)
        tid = new_id()
        ts = now_iso()
        if args.status:
            status = args.status
        elif parents and not all(s == "done" for p in parents for s in [con.execute("SELECT status FROM tasks WHERE id=?", (p,)).fetchone()["status"]]):
            status = "todo"
        else:
            status = "ready"
        labels = ",".join(args.label or [])
        con.execute(
            "INSERT INTO tasks (id, title, body, status, priority, assignee, labels, created_at, updated_at)"
            " VALUES (?,?,?,?,?,?,?,?,?)",
            (tid, args.title, args.body or "", status, args.priority, args.assignee or "", labels, ts, ts),
        )
        for p in parents:
            con.execute("INSERT INTO links (parent_id, child_id) VALUES (?,?)", (p, tid))
        emit(con, actor, "created", tid, title=args.title, status=status,
             assignee=args.assignee or "", priority=args.priority, parents=parents)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    task = get_task(con, tid)
    con.close()
    out(args, f"created {tid} [{status}] {args.title}", task)


def _filter_query(args):
    q = "SELECT * FROM tasks WHERE status != 'archived'"
    params = []
    if args.status:
        q += " AND status=?"
        params.append(args.status)
    if args.assignee:
        q += " AND assignee=?"
        params.append(args.assignee)
    for lb in (getattr(args, "label", None) or []):
        q += " AND (',' || labels || ',') LIKE ?"
        params.append(f"%,{lb},%")
    q += " ORDER BY priority DESC, created_at ASC"
    return q, params


